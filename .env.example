# ANILLIÉA — environment template.
# Copy to `.env` and fill in the blanks:  cp .env.example .env
# Never commit a real `.env` to version control.

# --- Database (matches docker-compose.yml defaults) -------------------
DATABASE_URL="postgresql://anilliea:anilliea@localhost:5432/anilliea?schema=public"

# --- Auth ---------------------------------------------------------------
# Sign and verify JWT session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="generate-a-long-random-string-min-32-chars"

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Seed users (used by `npx prisma db seed`) ---------------------------
ADMIN_EMAIL="nawzirahmed4@gmail.com"
ADMIN_PASSWORD="choose-a-strong-password"
DEMO_PASSWORD="choose-a-demo-password"

# --- Email ----------------------------------------------------------------
# In development, a missing SMTP host logs messages to the server console.
# In production, password reset returns 503 until SMTP is configured, so
# customers are never told an email was sent when it cannot be delivered.
# Order confirmation email is best-effort; checkout never fails because email
# delivery failed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ANILLIÉA <hello@anilliea.pk>"

# --- Bank transfer details (shown at checkout for BANK_TRANSFER orders) ---
# If none are set, the customer is asked to contact the store for details.
BANK_NAME=
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=

# --- Image uploads ---------------------------------------------------------
# Production: create a Blob store in the Vercel dashboard (Storage tab) and
# paste its read/write token here. Admin uploads then go to Vercel Blob.
# next.config.mjs allow-lists *.public.blob.vercel-storage.com for next/image.
# Without the token, uploads fall back to public/uploads/ (local dev only —
# files there are ephemeral on Vercel and disappear on redeploy).
BLOB_READ_WRITE_TOKEN=

# --- Payments ---------------------------------------------------------------
# COD and bank transfer are supported. ONLINE is deliberately unavailable and
# returns a clear 400 — no card gateway is integrated yet. PAYMENT_SECRET is
# reserved for a future callback-verification integration.
PAYMENT_SECRET=

# --- Operator diagnostics (optional) --------------------------------------
# /api/diag returns booleans/counts only. In production it is disabled unless
# this token is set and sent as: Authorization: Bearer <DIAG_TOKEN>.
# In development it is reachable without a token when this is unset.
DIAG_TOKEN=
