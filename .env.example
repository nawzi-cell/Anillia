# ANILLIÉA — environment template.
# Copy to `.env` and fill in the blanks:  cp .env.example .env
# Never commit a real `.env` to version control.

# --- Database (matches docker-compose.yml defaults) -------------------
DATABASE_URL="postgresql://anilliea:anilliea@localhost:5432/anilliea?schema=public"

# --- Auth ---------------------------------------------------------------
# Sign and verify JWT session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="generate-a-long-random-string-min-32-chars"

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Seed users (used by `npx prisma db seed`) ---------------------------
ADMIN_EMAIL="nawzirahmed4@gmail.com"
ADMIN_PASSWORD="choose-a-strong-password"
DEMO_PASSWORD="choose-a-demo-password"

# --- Email (optional) -----------------------------------------------------
# Until SMTP is configured, transactional email is best-effort: messages are
# logged to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ANILLIÉA <hello@anilliea.pk>"

# --- Bank transfer details (shown at checkout for BANK_TRANSFER orders) ---
BANK_NAME=
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=

# --- Payments ---------------------------------------------------------------
# Shared secret used to verify payment-related callbacks when an online
# gateway is integrated. Not needed for COD / bank transfer.
PAYMENT_SECRET=
